# Offline machine-assisted draft; contextual review, not certified
# translation.
#: babybuddy/site_settings.py:35
msgid ""
"The maximum default time that a sleep entry is consider a nap. If set the "
"nap property will be preselected if the start time is within the bounds."
msgstr ""
"El tiempo máximo por defecto que una entrada de sueño se considera una "
"siesta. Si está configurado, la propiedad de la siesta se preseleccionará si"
" la hora de inicio está dentro de los límites."

