# /etc/babybuddy/babybuddy.env  -  environment for the Baby Buddy service.
# See docs/configuration/ for every supported variable.
DJANGO_SETTINGS_MODULE=babybuddy.settings.base
DEBUG=False

# Generated by install.sh. Keep it secret and never change it after first run
# (sessions and password reset tokens depend on it).
SECRET_KEY=change-me

# Comma separated hostnames/IPs the Pi answers on, e.g. babybuddy.local,192.168.1.50
ALLOWED_HOSTS=babybuddy.local,localhost,127.0.0.1

# Origins (with scheme) the browser will be using, needed for form submissions.
CSRF_TRUSTED_ORIGINS=http://babybuddy.local

# Default timezone for new users, e.g. Pacific/Honolulu, Europe/Berlin.
TIME_ZONE=UTC

# Uncomment once nginx serves HTTPS.
# SECURE_PROXY_SSL_HEADER=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
